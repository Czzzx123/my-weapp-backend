# ============================================================
# 未蓝科技 · 智慧教育 —— 环境变量模板
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env      cp .env.example .env
#   2. 把下面的占位值替换成真实值
#   3. .env 已在 .gitignore 中，不会被提交
#
# 注意：本文件（.env.example）需要入库，只放占位值，绝不填写真实密钥。
# ============================================================

# ---- Django ----
# 生产环境必须换成随机长字符串，可用以下命令生成：
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---- 短信验证码（开发期开关，默认都是关闭的）----
# 这两个是**安全开关**，代码里的默认值是 False。
# 本地联调需要「任意手机号 + 固定码」时，在这里显式打开；
# 上线前必须删掉这两行（或改成 False），否则任何人都能登录任意手机号。
#
# SMS_DEV_FIXED_CODE=True   使用固定验证码，不真的发短信
# SMS_DEV_CODE=8888         固定码是什么
# SMS_DEV_RELAX=True        固定码可重复使用、不限重发间隔（必须与上一项同时 True 才生效）
SMS_DEV_FIXED_CODE=False
SMS_DEV_CODE=8888
SMS_DEV_RELAX=False

# ---- 微信小程序 ----
# AppID / AppSecret 在微信公众平台获取：
#   mp.weixin.qq.com -> 开发 -> 开发管理 -> 开发设置 -> 开发者ID
# AppSecret 只在生成时显示一次，务必立即保存；遗失只能重置（旧密钥立刻失效）
# 注意：AppSecret 只能放在后端，绝不能出现在小程序代码里
WECHAT_APPID=wx0000000000000000
WECHAT_APPSECRET=00000000000000000000000000000000

# ---- 公开访问地址 ----
# 开发期是本地地址；上线后改成 https 域名。
# 用于拼接 media 图片的完整 URL（前端无法直接使用相对路径）
PUBLIC_BASE_URL=http://127.0.0.1:8000
